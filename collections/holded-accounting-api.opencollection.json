            "url": "https://api.holded.com/api/accounting/v1/dailyjournal"
          },
          "docs": "List daily journal entries"
        },
        {
          "info": {
            "name": "Create a journal entry",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.holded.com/api/accounting/v1/dailyjournal"
          },
          "docs": "Create a journal entry"
        }
      ]
    }
  ],
  "bundled": true
}