            "url": "https://api.holded.com/api/team/v1/employees"
          },
          "docs": "Create an employee"
        },
        {
          "info": {
            "name": "List time-tracking entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.holded.com/api/team/v1/timetracking"
          },
          "docs": "List time-tracking entries"
        }
      ]
    }
